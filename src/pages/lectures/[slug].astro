---
import { render } from "astro:content";
import { getPublishedCollection } from "astro-course-university/content";
import RelatedContent from "astro-course-university/components/RelatedContent.astro";
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import { withBase } from "astro-theme-university/url";
import CaseStamp from "../../components/CaseStamp.astro";
import InterpretChoice from "../../components/InterpretChoice.astro";
import OracleGenerator from "../../components/OracleGenerator.astro";
import PerceptionCheck from "../../components/PerceptionCheck.astro";
import TeachingTeam from "../../components/TeachingTeam.astro";
import { formatCourseDate } from "../../lib/dates";
import { graphCollections, siteConfig } from "../../site-config";

export async function getStaticPaths() {
  const lectures = await getPublishedCollection("lectures");
  return lectures.map((lecture) => ({ params: { slug: lecture.id }, props: { lecture } }));
}

const { lecture } = Astro.props;
const { Content } = await render(lecture);
const title = `Week ${lecture.data.week}: ${lecture.data.title}`;

// `activity` rides the schema's `.loose()` passthrough, so its kind-specific
// fields aren't in the generated type and need a cast at the rendering
// boundary — the same pattern the people route already uses for `photoAlt`.
type Activity =
  | { kind: "perception"; prompt: string; options: string[]; reveal: string }
  | { kind: "interpret"; prompt: string; choices: { label: string; response: string }[] }
  | { kind: "oracle"; prompt: string; actionLabel?: string; outputs: string[]; mechanism: string };
const activity = lecture.data.activity as Activity | undefined;

// A shared week number feeds both the case stamp and each activity's kicker
// label, so "CASE 05" and "EXPERIMENT 05" always agree without a second
// source of truth.
const weekPadded = String(lecture.data.week).padStart(2, "0");
const activityLabel =
  activity?.kind === "perception"
    ? `Experiment ${weekPadded}`
    : activity?.kind === "interpret"
      ? `Interpretation test ${weekPadded}`
      : activity?.kind === "oracle"
        ? `Oracle ${weekPadded}`
        : undefined;
---

<ContentLayout title={title} description={lecture.data.description} {...siteConfig}>
  <p class="lecture-meta">
    <strong>{formatCourseDate(lecture.data.date)}</strong>
    <CaseStamp n={lecture.data.week} />
  </p>
  {lecture.data.slides && <p><a href={withBase(lecture.data.slides)}>Open the slides</a></p>}
  <p class="lecture-question">{lecture.data.question}</p>
  <Content />
  {
    activity?.kind === "perception" && (
      <PerceptionCheck
        prompt={activity.prompt}
        options={activity.options}
        reveal={activity.reveal}
        label={activityLabel}
      />
    )
  }
  {
    activity?.kind === "interpret" && (
      <InterpretChoice prompt={activity.prompt} choices={activity.choices} label={activityLabel} />
    )
  }
  {
    activity?.kind === "oracle" && (
      <OracleGenerator
        prompt={activity.prompt}
        actionLabel={activity.actionLabel}
        outputs={activity.outputs}
        mechanism={activity.mechanism}
        label={activityLabel}
      />
    )
  }
  <TeachingTeam teachers={lecture.data.teachers} />
  <RelatedContent entry={lecture} collections={graphCollections} />
</ContentLayout>

<style>
  .lecture-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .lecture-meta strong {
    font-family: var(--at-font-mono);
    font-size: var(--at-font-size-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--at-text-secondary);
    font-weight: 400;
  }

  .lecture-question {
    font-family: var(--at-font-heading);
    font-size: var(--at-font-size-h4);
    font-style: italic;
    color: var(--at-heading);
    border-inline-start: 3px solid var(--at-heading);
    padding-inline-start: var(--at-spacing-md);
    margin-block: 1.5rem;
  }
</style>
