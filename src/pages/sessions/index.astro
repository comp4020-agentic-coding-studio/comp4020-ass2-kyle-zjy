---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description={`Six working sessions, each tied to a specific assessment milestone rather than to every lecture week — where you practise making, breaking and pressure-testing an interpretation by hand before you're marked on one.`}
  {...siteConfig}
>
  <p>
    A lecture argues a week's case; a {sessionLabels.singular.toLowerCase()} is where you do
    something with it — start the diary, workshop a method, review a peer's draft, build or
    playtest a small oracle, or plan the final project. Each one names the assessment it feeds and
    what to bring.
  </p>
  <SessionsGrid />
</ContentLayout>
